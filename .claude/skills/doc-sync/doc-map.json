{
  "hubs": ["AGENTS.md", "README.md"],
  "orphan_scope": ["docs/*.md", ".claude/*.md"],

  "registries": {
    "skills_readme": "docs/references/skills/README.md",
    "agents_readme": "docs/references/agents/README.md",
    "agents_hub": "AGENTS.md",
    "orchestrator_skills": ["doc-sync"]
  },

  "mirrors": [
    {"source": {"file": ".env.example", "key": "OPENAI_CHAT_MODEL"},
     "in": ["README.md", "docs/references/environment.md", ".claude/skills/langchain-rag/SKILL.md"]},
    {"source": {"file": ".env.example", "key": "OPENAI_EMBEDDING_MODEL"},
     "in": ["README.md", "docs/references/environment.md", ".claude/skills/vectordb/SKILL.md"]},
    {"source": {"file": ".env.example", "key": "POSTGRES_PORT"},
     "in": ["README.md", "docs/references/environment.md"]},
    {"source": {"file": ".python-version"},
     "in": ["README.md", "docs/references/environment.md"]}
  ],

  "env_docs": {
    "source": ".env.example",
    "in": ["docs/references/environment.md", "README.md"]
  },

  "deps_docs": {
    "source": "pyproject.toml",
    "in": ["docs/references/environment.md"]
  },

  "forbidden": [
    {"pattern": "datas/",
     "in": [".claude/*", "AGENTS.md", "README.md", "docs/references/skills/*", "docs/references/agents/*", "docs/references/environment.md"],
     "skip": [".claude/skills/security-check/rules.json"],
     "why": "개인 작업 폴더. 팀원과 공유되지 않으므로 문서·스킬·에이전트에 의존을 남기지 않는다"}
  ],

  "coupling": [
    {"when": ["docs/problem.md"],
     "review": ["docs/persona-question-generator.md", ".claude/skills/question-design/SKILL.md"],
     "why": "페르소나·상황·질문이 바뀌면 생성 예시와 질문 입력 추출 규칙을 검토"},
    {"when": ["docs/persona-question-generator.md", ".claude/agents/question-designer.md", ".claude/skills/question-design/*", ".claude/skills/question-design/scripts/*"],
     "review": ["docs/persona-question-generator.md", "docs/references/question-design.md", ".claude/agents/question-designer.md", ".claude/skills/question-design/SKILL.md"],
     "why": "질문 후보 생성의 권한·입출력·실행·검증 안내"},
    {"when": [".claude/skills/*/SKILL.md"],
     "review": ["docs/references/skills/README.md"],
     "why": "스킬 목록·요약·사용 에이전트"},
    {"when": [".claude/agents/*.md"],
     "review": ["docs/references/agents/README.md", "AGENTS.md"],
     "why": "에이전트 표, 담당, 에이전트 간 계약"},
    {"when": [".claude/skills/chunking/SKILL.md"],
     "review": [".claude/skills/vectordb/SKILL.md", ".claude/skills/tool-calling/SKILL.md", ".claude/skills/langchain-rag/SKILL.md", "docs/references/agents/README.md"],
     "why": "청크 ID·섹션·메타데이터 키는 sync, 검색 툴 인자, 출처 표기에 쓰인다"},
    {"when": [".claude/skills/tool-calling/SKILL.md"],
     "review": [".claude/skills/langchain-rag/SKILL.md", "docs/references/skills/README.md"],
     "why": "툴 이름·개수·권장 흐름"},
    {"when": [".env.example", "docker-compose.yml", "docker/*", "pyproject.toml", ".python-version"],
     "review": ["docs/references/environment.md", "README.md"],
     "why": "개발 환경 설명"},
    {"when": ["data/processed/*", "scripts/gen1_battle/data_integrity.py"],
     "review": [".claude/skills/data-normalize/SKILL.md", "docs/references/skills/README.md"],
     "why": "기준 데이터 목록·개수·해시 고정 규칙"},
    {"when": ["scripts/gen1_battle/gen1_battle_rules.py"],
     "review": [".claude/skills/tool-calling/SKILL.md"],
     "why": "type_effectiveness 툴이 래핑하는 함수"},
    {"when": ["contracts/*"],
     "review": [".claude/skills/chunking/SKILL.md", ".claude/skills/tool-calling/SKILL.md"],
     "why": "메타데이터 계약과 툴 enum"},
    {"when": [".gitignore"],
     "review": [".claude/skills/security-check/rules.json"],
     "why": "커밋 금지 경로·.gitignore 프로브"},
    {"when": [".claude/skills/api-invariants/SKILL.md"],
     "review": [".claude/skills/api-architecture/SKILL.md", ".claude/skills/api-implementation/SKILL.md", ".claude/skills/layer-check/SKILL.md", ".claude/skills/fastapi-run/SKILL.md", ".claude/agents/api-implementer.md", ".claude/agents/api-reviewer.md", "AGENTS.md"],
     "why": "API 규칙 R번호·완료 게이트를 가리키는 스킬·에이전트·개발 루프"},
    {"when": ["docs/references/api-rag-integration.md", "api/chat/domain/generator.py", "api/chat/domain/answer.py"],
     "review": ["docs/references/api-rag-integration.md", ".claude/skills/api-architecture/SKILL.md", ".claude/skills/api-implementation/SKILL.md"],
     "why": "답변 생성기 계약 (API ↔ RAG)"},
    {"when": [".claude/skills/layered-architecture/SKILL.md", ".claude/skills/fsd-architecture/SKILL.md"],
     "review": [".claude/skills/api-architecture/SKILL.md", ".claude/skills/layer-check/SKILL.md"],
     "why": "공통 원칙을 적용하는 서비스 문서와 고정 검사 규칙"},
    {"when": [".claude/skills/layer-check/scripts/*"],
     "review": [".claude/skills/layer-check/SKILL.md", ".claude/skills/api-invariants/layer-profile.json"],
     "why": "프로파일 키·태그 표와 서비스 프로파일"},
    {"when": [".claude/skills/api-invariants/layer-profile.json"],
     "review": [".claude/skills/api-invariants/SKILL.md"],
     "why": "프로파일의 금지 패키지·규칙 ID는 R번호 표와 같아야 한다"},
    {"when": [".claude/skills/fastapi-run/scripts/*"],
     "review": [".claude/skills/fastapi-run/SKILL.md", ".claude/skills/api-invariants/SKILL.md"],
     "why": "공통 실행 스크립트의 환경 변수와 서비스 실행 확인 절"},
    {"when": [".claude/skills/api-invariants/scripts/*"],
     "review": [".claude/skills/api-invariants/SKILL.md"],
     "why": "smoke 항목 표"},
    {"when": [".claude/skills/doc-sync/doc-map.json"],
     "review": [".claude/skills/doc-sync/SKILL.md"],
     "why": "규칙 변경 시 스킬 설명"}
  ]
}
