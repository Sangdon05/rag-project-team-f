# 복사해서 사용: cp .env.example .env  (.env는 커밋 금지)

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Upstage
UPSTAGE_API_KEY=
UPSTAGE_EMBEDDING_MODEL=solar-embedding-2-passage
UPSTAGE_QUERY_MODEL=solar-embedding-2-query

# PostgreSQL + pgvector (docker compose 로컬 기본값, 운영과 동일하게 5432)
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pokedex:pokedex@localhost:5432/pokedex

# 벡터 컬렉션 = index_version (v{n}-{임베딩 약칭}-{템플릿 버전})
# 필수: 미지정 시 PGVector 기본 컬렉션 "langchain"에 섞인다. 앱이 읽을 인덱스 버전을 고르는 스위치.
PGVECTOR_COLLECTION=v1-te3s-tpl1

# FastAPI 서비스 (api/)
# 답변 생성기 선택: mock(기본, LLM 호출 없음) | llm(검색 없이 LLM, OPENAI_* 필요). 그 밖의 값이면 앱 시작 실패
ANSWER_BACKEND=mock
# 허용할 프론트 origin, 쉼표 구분 (예: http://localhost:5173). 비우면 CORS 미들웨어를 붙이지 않는다. "*" 금지
API_CORS_ORIGINS=
# 요청당 메시지 수 상한 (1 이상 정수)
API_MAX_MESSAGES=20
# documents 슬라이스가 읽는 원문 Markdown 폴더. 파일은 <폴더>/<source_ref_id>.md, 상대 경로는 서버 작업 디렉터리(저장소 루트) 기준
API_DOCUMENTS_DIR=data/synthetic/pilot
