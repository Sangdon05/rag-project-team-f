# 복사해서 사용: cp .env.example .env  (.env는 커밋 금지)

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL + pgvector (docker compose 로컬 기본값, 5432/5433 충돌을 피해 5434)
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://pokedex:pokedex@localhost:5434/pokedex

# 벡터 컬렉션 = index_version (v{n}-{임베딩 약칭}-{템플릿 버전})
# 필수: 미지정 시 PGVector 기본 컬렉션 "langchain"에 섞인다. 앱이 읽을 인덱스 버전을 고르는 스위치.
PGVECTOR_COLLECTION=v1-te3s-tpl1
